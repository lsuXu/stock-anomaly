#!/bin/bash

# ==============================================================================
# A股异动监控与推演系统 - 一键启动脚本 (macOS 双击即用)
# ==============================================================================

# 确保工作目录切换到当前脚本所在文件夹
cd "$(dirname "$0")"

PORT=8080
URL="http://127.0.0.1:${PORT}"

echo "========================================================================"
echo " 🚀 正在启动 A股股票异动监控与未来推演测算系统..."
echo "========================================================================"

# 1. 检查 Python 3 环境
if ! command -v python3 &> /dev/null; then
    echo "❌ 错误: 未检测到 Python 3 环境，请先安装 Python 3 后再运行。"
    echo "按任意键退出..."
    read -n 1
    exit 1
fi

# 2. 检查 8080 端口是否已被旧进程占用，如有则自动释放
EXISTING_PID=$(lsof -ti :${PORT} 2>/dev/null)
if [ -n "$EXISTING_PID" ]; then
    echo "💡 检测到端口 ${PORT} 已有历史进程 (PID: ${EXISTING_PID})，正在自动清理重启..."
    kill -9 ${EXISTING_PID} 2>/dev/null
    sleep 1
fi

# 3. 延迟 1 秒后自动在默认浏览器中打开网页
(
    sleep 1.2
    echo "🌐 正在为您自动打开浏览器: ${URL}"
    open "${URL}"
) &

echo " Web 服务运行中: ${URL}"
echo " 提示: 浏览器将自动弹开网页；若需停止服务，在此窗口按 Ctrl + C 即可。"
echo "========================================================================"

# 4. 启动服务
exec python3 main.py --server --port ${PORT}
